# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://studytube:studytube@localhost:5432/studytube

# Google Gemini (server-side only)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_VIDEO_MODEL=gemini-3.6-flash

# Automatic fallback for videos without usable YouTube captions
AUDIO_FALLBACK_ENABLED=true
AUDIO_FALLBACK_MAX_SECONDS=1800
AUDIO_FALLBACK_MAX_BYTES=104857600
PROCESSING_LEASE_MS=2700000

# RAG tuning (characters, not tokens)
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5
EMBEDDING_BATCH_SIZE=10
MAX_TRANSCRIPT_CHARS=2000000

# Request protection
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# Frontend (safe to expose)
VITE_API_URL=http://localhost:4000/api
